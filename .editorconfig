root = true

[*]
charset = utf-8
end_of_line = lf
indent_size = 4
indent_style = space
insert_final_newline = true
trim_trailing_whitespace = true

[*.md]
trim_trailing_whitespace = false

[*.{yml,yaml}]
indent_size = 2

[docker-compose.yml]
indent_size = 4

[*.{vue,js,json,scss,css}]
indent_size = 2

[*.config.js]
indent_size = 4

[{tailwind,postcss}.config.js]
indent_size = 2
